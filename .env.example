# Agendo — Backend environment variables
#
# IMPORTANT: The DeepSeek API key must NEVER be exposed to the frontend.
# Do NOT use VITE_ prefix (Vite exposes VITE_ variables to the browser).
# Keep this key in the backend only and proxy AI requests through your
# own server route (e.g. POST /api/deepseek). The frontend calls that
# relative route and never handles the key.

DEEPSEEK_API_KEY=sk-tu-clave-deepseek-aqui
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Port for the backend proxy (if you run one alongside Vite)
PORT=3000
